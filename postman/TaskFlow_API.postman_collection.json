    {
      "name": "05. Raporlama Servisleri (İsteğe Bağlı 03)",
      "item": [
        {
          "name": "Tamamlanan Görev Sayısı (GET /reports/completed)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/completed",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "completed"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Durum kodu 200 OK olmalıdır\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Tamamlanan görev rapor formatı doğrulanmalıdır\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.reportType).to.eql(\"COMPLETED_TASKS\");",
                  "    pm.expect(jsonData.summary.completedCount).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Bekleyen Görev Sayısı (GET /reports/pending)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/pending",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "pending"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Durum kodu 200 OK olmalıdır\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Bekleyen görev rapor formatı doğrulanmalıdır\", function () {",
