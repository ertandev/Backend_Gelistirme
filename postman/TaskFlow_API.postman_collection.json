                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Genel Sistem Özeti (GET /reports/summary)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/summary",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "summary"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Durum kodu 200 OK olmalıdır\", function () {",
