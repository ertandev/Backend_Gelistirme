            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Durum kodu 200 OK olmalıdır\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Sayfa limiti 3 olmalı ve pagination verisi bulunmalıdır\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.length).to.eql(3);",
                  "    pm.expect(jsonData.pagination.currentPage).to.eql(1);",
                  "    pm.expect(jsonData.pagination.limit).to.eql(3);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
